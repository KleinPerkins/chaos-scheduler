{
  "name": "app",
  "private": true,
  "version": "1.8.0",
  "type": "module",
  "scripts": {
    "dev": "npm run tokens && vite",
    "build": "npm run tokens && tsc -b && vite build",
    "tokens": "style-dictionary build --config style-dictionary.config.mjs && prettier --write src/styles/tokens.css src/styles/tokens.ts figma-tokens.json",
    "tokens:validate": "node scripts/validate-tokens.mjs",
    "tokens:check": "node scripts/check-tokens-fresh.mjs",
    "test:tokens": "node --test scripts/validate-tokens.test.mjs",
    "figma:typecheck": "tsc -p tsconfig.figma.json",
    "code-connect:check": "node scripts/check-code-connect.mjs",
    "test:code-connect": "node --test scripts/check-code-connect.test.mjs",
    "test:figma-snapshot": "node --test scripts/figma-snapshot.test.mjs",
    "check:mcp-diff-attribute": "node scripts/check-mcp-diff-attribute.mjs",
    "test:mcp-diff-attribute": "node --test scripts/check-mcp-diff-attribute.test.mjs",
    "check:no-committed-data": "node scripts/check-no-committed-data.mjs",
    "test:no-committed-data": "node --test scripts/check-no-committed-data.test.mjs",
    "check:mcp-config-secret-free": "node scripts/check-mcp-config-secret-free.mjs",
    "test:mcp-config-secret-free": "node --test scripts/check-mcp-config-secret-free.test.mjs",
    "check:no-raw-hex": "node scripts/check-no-raw-hex.mjs",
    "test:no-raw-hex": "node --test scripts/check-no-raw-hex.test.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,cjs,mjs,json,css,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,cjs,mjs,json,css,md,yml,yaml}\"",
    "commitlint": "commitlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "test:visual:update": "playwright test -c playwright.visual.config.ts --update-snapshots",
    "test:a11y": "playwright test -c playwright.a11y.config.ts",
    "test:packages": "npm run test:packages:sdk-ts && npm run test:packages:mcp-server",
    "test:packages:sdk-ts": "npm ci --prefix packages/sdk-ts && npm run build --prefix packages/sdk-ts && npm test --prefix packages/sdk-ts",
    "test:packages:mcp-server": "npm ci --prefix packages/mcp-server && npm run build --prefix packages/mcp-server && npm test --prefix packages/mcp-server",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-positioner": "^2.3.4",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "@tauri-apps/plugin-sql": "^2.4.1",
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "d3-time": "^3.1.0",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "^10.0.1",
    "@figma/code-connect": "^2.0.1",
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "^2.12.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/d3-time": "^3.0.4",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "^8.20.0",
    "eslint": "^10.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "lefthook": "2.1.15",
    "prettier": "3.9.9",
    "style-dictionary": "^5.5.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "minimatch@3": {
      "brace-expansion": "^1.1.17"
    },
    "minimatch@9": {
      "brace-expansion": "^2.1.3"
    },
    "minimatch@10": {
      "brace-expansion": "^5.0.8"
    }
  }
}
